---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout>
<Fragment slot="head">
<meta name="description" content="Send BlueYucca your ideas, collaboration proposals, template requests, or the link to the website you built. A real person reads everything.">
<title>Contact BlueYucca | Ideas, Collaboration, and Hello</title>
<link rel="canonical" href="https://blueyucca.com/contact">
<meta property="og:site_name" content="BlueYucca">
<meta property="og:type" content="website">
<meta property="og:title" content="Contact BlueYucca | Ideas, Collaboration, and Hello">
<meta property="og:description" content="Send BlueYucca your ideas, collaboration proposals, template requests, or the link to the website you built. A real person reads everything.">
<meta property="og:url" content="https://blueyucca.com/contact">
<meta name="twitter:card" content="summary_large_image">
<style is:inline>
  :root {
    --cream: #FAF6ED; --cream-deep: #F3ECDC; --card: #FFFDF8;
    --sand: #E5DAC3; --sand-dark: #D5C6A5;
    --ink: #1E2A45; --ink-soft: #52607E;
    --blue: #2455C4; --blue-deep: #17357F; --blue-dark: #1B3A8C;
    --blue-soft: #4B79DC; --blue-wash: #E9EFFB; --blue-line: #C9D8F5;
    --haz: #F2C94C;
    --mono: "SFMono-Regular", Menlo, Consolas, "Courier New", monospace;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--cream); color: var(--ink); line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--blue); color: var(--cream); }
  a { color: var(--blue); }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; }
  }

  .hero { padding: 64px 0 40px; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.1rem); line-height: 1.08; letter-spacing: -0.03em; font-weight: 850; color: var(--ink); margin-bottom: 16px; }
  .lede { font-size: clamp(1.02rem, 2vw, 1.15rem); color: var(--ink-soft); margin-bottom: 26px; }
  section { padding: 8px 0 56px; }
  .eyebrow {
    display: inline-block; font-family: var(--mono);
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--blue);
    border: 1.5px solid var(--blue-line); background: var(--blue-wash);
    border-radius: 6px; padding: 3px 10px; margin-bottom: 14px;
  }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -0.02em; line-height: 1.15; font-weight: 800; color: var(--ink); margin: 42px 0 12px; }
  h3 { color: var(--ink); letter-spacing: -0.01em; }
  .btn {
    display: inline-block; text-decoration: none; font-weight: 700;
    padding: 12px 24px; border-radius: 10px; font-size: 1rem;
    border: 2px solid var(--blue-deep); margin: 4px 8px 4px 0;
    transition: transform 0.1s ease, box-shadow 0.1s ease; cursor: pointer;
  }
  .btn-primary { background: var(--blue); color: #fff; box-shadow: 0 4px 0 var(--blue-deep); }
  .btn-primary:hover { transform: translateY(3px); box-shadow: 0 1px 0 var(--blue-deep); }
  .btn-ghost { color: var(--blue-deep); background: var(--card); box-shadow: 0 4px 0 var(--sand-dark); border-color: var(--ink); }
  .btn-ghost:hover { transform: translateY(3px); box-shadow: 0 1px 0 var(--sand-dark); }
  .note {
    background: var(--blue-wash); border: 2px solid var(--blue-line); border-radius: 12px;
    padding: 18px 22px; font-size: 0.98rem; margin: 28px 0;
  }
  .pricetag {
    display: inline-block; font-family: var(--mono); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.06em; color: var(--blue-deep); background: var(--haz);
    border: 2px solid var(--ink); border-radius: 6px; padding: 3px 10px;
    box-shadow: 2px 2px 0 var(--sand-dark); transform: rotate(-1.5deg);
  }
  ul.check { list-style: none; padding: 0; margin: 16px 0; }
  ul.check li { padding: 7px 0 7px 32px; position: relative; color: var(--ink); }
  ul.check li::before {
    content: "\2713"; position: absolute; left: 4px; top: 7px;
    color: var(--blue); font-weight: 900; font-family: var(--mono);
  }
  .promptbox {
    background: #141821; color: #C7E3D4; border: 2px solid var(--ink); border-radius: 12px;
    padding: 20px 22px; font-family: var(--mono); font-size: 0.86rem; line-height: 1.6;
    white-space: pre-wrap; margin: 16px 0; box-shadow: 5px 5px 0 var(--sand-dark);
  }
  .retro-badge {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--mono); font-size: 0.74rem; font-weight: 700;
    color: var(--blue-deep); background: var(--card);
    border: 2px solid var(--ink); border-radius: 6px;
    padding: 5px 12px; margin-bottom: 18px; box-shadow: 3px 3px 0 var(--sand-dark);
  }
  footer.site-footer { border-top: 2px solid var(--ink); margin-top: 48px; padding: 40px 0 48px; text-align: center; color: var(--ink-soft); font-size: 0.93rem; }
  footer.site-footer nav { margin-bottom: 12px; }
  footer.site-footer nav a { color: var(--blue-deep); text-decoration: none; margin: 0 10px; font-weight: 600; }
  footer.site-footer nav a:hover { text-decoration: underline; }
  @media (max-width: 760px) {  .hero { padding: 44px 0 28px; } }
  .contact-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 36px; margin: 10px 0 30px; align-items: start; }
  @media (max-width: 820px) { .contact-grid { grid-template-columns: 1fr; } }
  .cfield { margin-bottom: 18px; }
  .cfield label { display: block; font-weight: 700; color: var(--ink); margin-bottom: 6px; font-size: 0.97rem; }
  .cfield input, .cfield textarea, .cfield select {
    width: 100%; padding: 11px 13px; border: 2px solid var(--ink); border-radius: 10px;
    font-family: inherit; font-size: 1rem; background: var(--card); color: var(--ink);
    box-shadow: 3px 3px 0 var(--sand); transition: box-shadow 0.12s ease;
  }
  .cfield input:focus, .cfield textarea:focus, .cfield select:focus {
    outline: none; border-color: var(--blue); box-shadow: 3px 3px 0 var(--blue-soft);
  }
  .cfield textarea { min-height: 140px; resize: vertical; }
  .cfield input::placeholder, .cfield textarea::placeholder { color: #9AA3B8; font-style: italic; }
  .hp { position: absolute; left: -9999px; opacity: 0; height: 0; overflow: hidden; }
  .side-card {
    background: var(--card); border: 2px solid var(--ink); border-radius: 14px;
    padding: 24px 26px; box-shadow: 5px 5px 0 var(--sand-dark); transform: rotate(0.6deg);
  }
  .side-card h3 { margin-bottom: 10px; font-size: 1.2rem; }
  .side-card p { color: var(--ink-soft); font-size: 0.95rem; margin-bottom: 12px; }
  .side-card .mono-note { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-soft); border-top: 2px dashed var(--sand-dark); padding-top: 12px; }
  .sent-card {
    display: none; background: var(--blue-wash); border: 2px solid var(--ink); border-radius: 14px;
    padding: 28px; box-shadow: 5px 5px 0 var(--blue-soft); text-align: center;
  }
  .sent-card .big { font-family: var(--mono); font-weight: 700; font-size: 1.3rem; color: var(--blue-deep); margin-bottom: 10px; }
  .err { display: none; margin-top: 14px; color: #B04A3A; font-weight: 600; }
</style>
</Fragment>
<Header />

<div class="wrap">
  <section class="hero" style="padding-bottom: 10px;">
    <span class="eyebrow">Say hello</span>
    <h1>Contact BlueYucca.</h1>
    <p class="lede">Ideas, collaborations, corrections, success stories, or just a note to say you put your first site online. It all goes to a real person. Response times vary from minutes to geological, but everything gets read.</p>
  </section>

  <div class="contact-grid">
    <div>
      <form id="contactForm">
        <input type="hidden" name="access_key" value="773a487f-054a-4c6e-9e41-ecf83cdd61b6">
        <input type="hidden" name="subject" value="BlueYucca contact form">
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off">
        <div class="cfield">
          <label for="cname">Your name</label>
          <input id="cname" name="name" type="text" required placeholder="Example: Pat from Surprise">
        </div>
        <div class="cfield">
          <label for="cemail">Your email</label>
          <input id="cemail" name="email" type="email" required placeholder="So a reply has somewhere to go">
        </div>
        <div class="cfield">
          <label for="ctopic">What is this about?</label>
          <select id="ctopic" name="topic">
            <option>An idea for BlueYucca</option>
            <option>A collaboration</option>
            <option>A bug or a typo</option>
            <option>I built my site and wanted to tell someone</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="cfield">
          <label for="cmsg">Your message</label>
          <textarea id="cmsg" name="message" required placeholder="Plain words work best here too."></textarea>
        </div>
        <button class="btn btn-primary" type="submit" id="sendBtn">Send it</button>
        <div class="err" id="sendErr">That did not go through. Please try again in a minute. The internet has moods.</div>
      </form>

      <div class="sent-card" id="sentCard">
        <div class="big">MESSAGE SENT &#10003;</div>
        <p>Thank you. It is now sitting in a real inbox, read by a real person.</p>
        <p style="font-family: var(--mono); font-size: 0.76rem; color: var(--ink-soft);">No newsletter was silently signed up for. Obviously.</p>
      </div>
    </div>

    <div class="side-card reveal">
      <h3>What this is for</h3>
      <p>BlueYucca gets better when people poke at it. Template requests, hosting guides you wish existed, businesses that want to be an example, or tools that would help you own your corner of the web.</p>
      <p>If you built something with these templates, send the link. Seeing real sites in the wild is the whole reward for a free project.</p>
      <div class="mono-note">This form sends an email and does nothing else. No list, no tracking, no follow up sequence with "just bumping this" energy.</div>
    </div>
  </div>
</div>

<footer class="site-footer">
  <div class="wrap">
    <div class="retro-badge">REPLIES HANDCRAFTED, LIKE THE HTML</div>
    <nav>
      <a href="/">Home</a> &middot;
      <a href="/business-in-a-box">Tools</a> &middot;
      <a href="/examples">Examples</a> &middot;
      <a href="/prompt-builder">Prompt Builder</a> &middot;
      <a href="/hosting">Hosting Guide</a> &middot;
      <a href="/blog/">Blog</a> &middot;
      <a href="/contact">Contact</a> &middot;
      <a href="/frontpage/">The FrontPage Experiment</a> &middot;
      <a href="https://www.tiktok.com/@blueyucca">TikTok</a>
    </nav>
    <div>BlueYucca is a <a href="https://cultivatum.com">Cultivatum LLC</a> project, part of the <a href="https://kakt.ai">kakt.ai</a> family. Arizona, est. 2003.</div>
  </div>
</footer>

<script is:inline>
(function () {
  var els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('in'); }); return; }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  els.forEach(function (el) { io.observe(el); });
})();
</script>
<script is:inline>
document.getElementById('contactForm').addEventListener('submit', function (e) {
  e.preventDefault();
  var form = e.target;
  var btn = document.getElementById('sendBtn');
  var err = document.getElementById('sendErr');
  err.style.display = 'none';
  btn.disabled = true; btn.textContent = 'Sending...';
  var data = new FormData(form);
  fetch('https://api.web3forms.com/submit', { method: 'POST', body: data })
    .then(function (r) { return r.json(); })
    .then(function (json) {
      if (json.success) {
        form.style.display = 'none';
        document.getElementById('sentCard').style.display = 'block';
      } else { throw new Error(json.message || 'failed'); }
    })
    .catch(function () {
      err.style.display = 'block';
      btn.disabled = false; btn.textContent = 'Send it';
    });
});
</script>
</Layout>
