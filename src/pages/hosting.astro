---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout>
<Fragment slot="head">
<meta name="description" content="Step by step guide to free website hosting on Cloudflare Pages and low cost hosting on Bunny.net. Written for non-technical small business owners. No coding tools needed.">
<title>How to Host an HTML Website for Free | BlueYucca Hosting Guide</title>
<link rel="canonical" href="https://blueyucca.com/hosting">
<meta property="og:site_name" content="BlueYucca">
<meta property="og:type" content="website">
<meta property="og:title" content="How to Host an HTML Website for Free | BlueYucca Hosting Guide">
<meta property="og:description" content="Step by step guide to free website hosting on Cloudflare Pages and low cost hosting on Bunny.net. Written for non-technical small business owners. No coding tools needed.">
<meta property="og:url" content="https://blueyucca.com/hosting">
<meta name="twitter:card" content="summary">
<style is:inline>
  :root {
    --cream: #FAF6ED; --cream-deep: #F3ECDC; --card: #FFFDF8;
    --sand: #E5DAC3; --sand-dark: #D5C6A5;
    --ink: #1E2A45; --ink-soft: #52607E;
    --blue: #2455C4; --blue-deep: #17357F; --blue-dark: #1B3A8C;
    --blue-soft: #4B79DC; --blue-wash: #E9EFFB; --blue-line: #C9D8F5;
    --haz: #F2C94C;
    --mono: "SFMono-Regular", Menlo, Consolas, "Courier New", monospace;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    background: var(--cream); color: var(--ink); line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  ::selection { background: var(--blue); color: var(--cream); }
  a { color: var(--blue); }
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
  .reveal { opacity: 0; transform: translateY(22px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .reveal.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
    html { scroll-behavior: auto; }
  }

  .hero { padding: 64px 0 40px; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.1rem); line-height: 1.08; letter-spacing: -0.03em; font-weight: 850; color: var(--ink); margin-bottom: 16px; }
  .lede { font-size: clamp(1.02rem, 2vw, 1.15rem); color: var(--ink-soft); margin-bottom: 26px; }
  section { padding: 8px 0 56px; }
  .eyebrow {
    display: inline-block; font-family: var(--mono);
    font-size: 0.78rem; font-weight: 700; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--blue);
    border: 1.5px solid var(--blue-line); background: var(--blue-wash);
    border-radius: 6px; padding: 3px 10px; margin-bottom: 14px;
  }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); letter-spacing: -0.02em; line-height: 1.15; font-weight: 800; color: var(--ink); margin: 42px 0 12px; }
  h3 { color: var(--ink); letter-spacing: -0.01em; }
  .btn {
    display: inline-block; text-decoration: none; font-weight: 700;
    padding: 12px 24px; border-radius: 10px; font-size: 1rem;
    border: 2px solid var(--blue-deep); margin: 4px 8px 4px 0;
    transition: transform 0.1s ease, box-shadow 0.1s ease; cursor: pointer;
  }
  .btn-primary { background: var(--blue); color: #fff; box-shadow: 0 4px 0 var(--blue-deep); }
  .btn-primary:hover { transform: translateY(3px); box-shadow: 0 1px 0 var(--blue-deep); }
  .btn-ghost { color: var(--blue-deep); background: var(--card); box-shadow: 0 4px 0 var(--sand-dark); border-color: var(--ink); }
  .btn-ghost:hover { transform: translateY(3px); box-shadow: 0 1px 0 var(--sand-dark); }
  .note {
    background: var(--blue-wash); border: 2px solid var(--blue-line); border-radius: 12px;
    padding: 18px 22px; font-size: 0.98rem; margin: 28px 0;
  }
  .pricetag {
    display: inline-block; font-family: var(--mono); font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.06em; color: var(--blue-deep); background: var(--haz);
    border: 2px solid var(--ink); border-radius: 6px; padding: 3px 10px;
    box-shadow: 2px 2px 0 var(--sand-dark); transform: rotate(-1.5deg);
  }
  ul.check { list-style: none; padding: 0; margin: 16px 0; }
  ul.check li { padding: 7px 0 7px 32px; position: relative; color: var(--ink); }
  ul.check li::before {
    content: "\2713"; position: absolute; left: 4px; top: 7px;
    color: var(--blue); font-weight: 900; font-family: var(--mono);
  }
  .promptbox {
    background: #141821; color: #C7E3D4; border: 2px solid var(--ink); border-radius: 12px;
    padding: 20px 22px; font-family: var(--mono); font-size: 0.86rem; line-height: 1.6;
    white-space: pre-wrap; margin: 16px 0; box-shadow: 5px 5px 0 var(--sand-dark);
  }
  .retro-badge {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--mono); font-size: 0.74rem; font-weight: 700;
    color: var(--blue-deep); background: var(--card);
    border: 2px solid var(--ink); border-radius: 6px;
    padding: 5px 12px; margin-bottom: 18px; box-shadow: 3px 3px 0 var(--sand-dark);
  }
  footer.site-footer { border-top: 2px solid var(--ink); margin-top: 48px; padding: 40px 0 48px; text-align: center; color: var(--ink-soft); font-size: 0.93rem; }
  footer.site-footer nav { margin-bottom: 12px; }
  footer.site-footer nav a { color: var(--blue-deep); text-decoration: none; margin: 0 10px; font-weight: 600; }
  footer.site-footer nav a:hover { text-decoration: underline; }
  @media (max-width: 760px) {  .hero { padding: 44px 0 28px; } }
  ol.steps { counter-reset: s; list-style: none; margin: 18px 0 8px; }
  ol.steps li { counter-increment: s; position: relative; padding: 8px 0 8px 48px; color: var(--ink); }
  ol.steps li::before {
    content: counter(s, decimal-leading-zero); position: absolute; left: 0; top: 10px;
    font-family: var(--mono); font-weight: 700; font-size: 0.85rem; color: var(--blue);
    border: 1.5px solid var(--blue-line); background: var(--blue-wash); border-radius: 6px; padding: 1px 7px;
  }
  .receipt {
    background: var(--card); border: 2px dashed var(--ink); border-radius: 4px;
    max-width: 380px; margin: 36px 0 10px; padding: 24px 26px;
    font-family: var(--mono); font-size: 0.85rem; color: var(--ink);
    box-shadow: 5px 5px 0 var(--sand-dark); transform: rotate(-0.6deg);
  }
  .receipt .row { display: flex; justify-content: space-between; padding: 3px 0; }
  .receipt .rule { border-top: 2px dashed var(--sand-dark); margin: 10px 0; }
  .receipt .total { font-weight: 700; font-size: 1rem; }
  .receipt .fine { color: var(--ink-soft); font-size: 0.72rem; margin-top: 12px; }
  .guarantee {
    background: var(--blue-wash); border: 2px solid var(--ink); border-radius: 14px;
    padding: 24px 26px; margin: 30px 0; max-width: 620px;
    box-shadow: 5px 5px 0 var(--blue-soft); transform: rotate(0.4deg);
  }
  .guarantee .g-title { font-family: var(--mono); font-weight: 700; font-size: 0.8rem; letter-spacing: 0.12em; color: var(--blue); margin-bottom: 8px; }
</style>
</Fragment>
<Header />

<div class="wrap">
  <section class="hero">
    <span class="eyebrow">Step 3: Publish</span>
    <h1>Put your site online.</h1>
    <p class="lede">You have an HTML file. Now the world needs to see it. Here are two good homes for it: one free, one nearly free. Both let you leave anytime and take your files with you, because they were always yours.</p>
  </section>

  <h2 class="reveal">Option 1: Cloudflare Pages (free)</h2>
  <p><a href="https://pages.cloudflare.com">Cloudflare Pages</a> hosts simple websites for free on a fast global network. This very site runs on it. Here is the drag and drop way, no coding tools needed.</p>
  <ol class="steps">
    <li><strong>Make an account.</strong> Go to <a href="https://dash.cloudflare.com">dash.cloudflare.com</a> and sign up with your email. The free plan is all you need.</li>
    <li><strong>Find Pages.</strong> In the left menu, look for "Workers &amp; Pages," then choose "Create" and pick the <strong>Pages</strong> tab.</li>
    <li><strong>Choose direct upload.</strong> Select "Upload assets." Give your project a short name. This becomes part of your free web address.</li>
    <li><strong>Upload your files.</strong> Drag your website folder (or your single index.html file) into the upload box, then click Deploy.</li>
    <li><strong>Visit your site.</strong> In about a minute you get a live address like yourproject.pages.dev. Click it. That is your website, online.</li>
    <li><strong>Add your own domain (optional).</strong> If you own a domain name, open your project, choose "Custom domains," and follow the short steps. Cloudflare walks you through it.</li>
  </ol>
  <div class="note">
    <strong>Good to know:</strong> every upload replaces the whole site, so always upload your complete folder, not just the one file you changed. Keep a copy of your site folder somewhere safe. It is your property.
  </div>

  <h2 class="reveal">Option 2: Bunny.net (low cost)</h2>
  <p><a href="https://bunny.net">Bunny.net</a> is a friendly, inexpensive option that typically costs pennies to a few dollars a month for a small site. It is a good fit if you want simple pay for what you use pricing.</p>
  <ol class="steps">
    <li><strong>Make an account.</strong> Sign up at <a href="https://bunny.net">bunny.net</a>. You add a small amount of credit (they have a minimum top up) and it lasts a long time for a small site.</li>
    <li><strong>Create a storage zone.</strong> In the dashboard, open "Storage" and create a storage zone. Think of it as your folder in the cloud.</li>
    <li><strong>Upload your files.</strong> Open the storage zone and upload your index.html and any other site files right in the browser.</li>
    <li><strong>Connect a pull zone.</strong> Create a "Pull Zone" and point it at your storage zone. This is what makes your files load fast around the world.</li>
    <li><strong>Visit your site.</strong> Bunny gives you an address ending in b-cdn.net. Your site is live.</li>
    <li><strong>Add your own domain (optional).</strong> In the pull zone settings, add your domain as a hostname and follow their steps to connect it and turn on the free SSL certificate.</li>
  </ol>

  <h2 class="reveal">Which one should you pick?</h2>
  <p>If you are not sure, start with Cloudflare Pages. It is free, fast, and the drag and drop upload is hard to beat. Bunny.net shines if you later want more control or you are already using it for other things. Either way you can switch anytime, because your website is just files, and the files are yours.</p>

  <div class="receipt reveal" aria-label="A pretend receipt showing everything costs zero dollars">
    <div class="row"><span>BLUEYUCCA</span><span>RECEIPT</span></div>
    <div class="rule"></div>
    <div class="row"><span>Templates</span><span>$0.00</span></div>
    <div class="row"><span>Prompt builder</span><span>$0.00</span></div>
    <div class="row"><span>Hosting guide</span><span>$0.00</span></div>
    <div class="row"><span>Your website files</span><span>PRICELESS*</span></div>
    <div class="rule"></div>
    <div class="row total"><span>GRAND TOTAL</span><span>$0.00</span></div>
    <div class="fine">We checked the math twice. *Priceless because they are yours, not because we plan to charge for them later.</div>
  </div>

  <div class="guarantee reveal">
    <div class="g-title">THE BLUEYUCCA GUARANTEE</div>
    <p>If you are ever unsatisfied, we will refund your $0.00 in full. No questions asked. No forms either.</p>
  </div>
</div>

<footer class="site-footer">
  <div class="wrap">
    <div class="retro-badge">BEST VIEWED IN ANY BROWSER &#10003;</div>
    <nav>
      <a href="/">Home</a> &middot;
      <a href="/business-in-a-box">Tools</a> &middot;
      <a href="/examples">Examples</a> &middot;
      <a href="/prompt-builder">Prompt Builder</a> &middot;
      <a href="/hosting">Hosting Guide</a> &middot;
      <a href="/blog/">Blog</a> &middot;
      <a href="/contact">Contact</a> &middot;
      <a href="/frontpage/">The FrontPage Experiment</a> &middot;
      <a href="https://www.tiktok.com/@blueyucca">TikTok</a>
    </nav>
    <div>BlueYucca is a <a href="https://cultivatum.com">Cultivatum LLC</a> project, part of the <a href="https://kakt.ai">kakt.ai</a> family. Arizona, est. 2003.</div>
  </div>
</footer>

<script is:inline>
(function () {
  var els = document.querySelectorAll('.reveal');
  if (!('IntersectionObserver' in window)) { els.forEach(function (el) { el.classList.add('in'); }); return; }
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.12 });
  els.forEach(function (el) { io.observe(el); });
})();
</script>
</Layout>
