      <text x="300" y="250" text-anchor="middle" font-family="SFMono-Regular, Menlo, Consolas, monospace" font-size="16" font-weight="700" letter-spacing="2" fill="var(--ink)" stroke="none">YOURS</text>
    </g>
  </g>
</svg>
