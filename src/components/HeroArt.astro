  <ellipse cx="210" cy="298" rx="170" ry="12" fill="var(--sand-dark)"/>
  <g stroke="var(--ink)" stroke-width="3" stroke-linejoin="round">
    <path d="M75 128 120 86l45 42z" fill="var(--haz)"/>
    <rect x="86" y="124" width="68" height="70" fill="var(--card)"/>
    <rect x="110" y="150" width="20" height="44" fill="var(--blue-wash)"/>
    <g transform="rotate(10 325 135)">
      <rect x="280" y="104" width="92" height="62" fill="var(--card)"/>
      <path d="m280 108 46 32 46-32" fill="none"/>
    </g>
    <g fill="var(--blue-soft)">
      <path d="M188 180 150 82l50 98z"/>
      <path d="M198 180 176 44l34 136z"/>
      <path d="M208 180 212 22l12 158z"/>
      <path d="M218 180 248 46l-16 134z"/>
